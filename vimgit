#!/usr/bin/perl -w


my $HELP = << 'EOF';
*vimgit.txt*
EOF

use strict;

use FindBin qw ($RealBin);
use lib "$RealBin/lib", "$RealBin/perl5";

use local::lib;

use File::Basename;
use File::Spec;
use FileHandle;
use Getopt::Long qw (:config no_ignore_case);
use Data::Dumper;
use File::Path;
use Cwd qw ();
use vimgit::mini;
use vimgit::workspace;

# directory of vimgit, symbolic links resolved
our $BIN = $RealBin;


sub bt
{
  for (my $i = 0; ; $i++)
    {
      last unless (my @call = caller ($i));
      return if ($call[3] eq '(eval)');
    }

  print @_;

  print "\n";
  for (my $i = 0; ; $i++)
    {
      last unless (my @call = caller ($i));
      print " $i ", $call[1], ':', $call[2], "\n";
    }
  die "\n";
}

$SIG{__WARN__} = \&bt;
$SIG{__DIE__} = \&bt;

my @opts = qw (d v i I g b w h x);
my %opts = map { ($_, 0), } @opts;
$opts{j} = 4;
&GetOptions ((map { ($_, \$opts{$_}) } @opts), 'j=i' => \$opts{j});

# the backtrace may be read from files given on the command line : before changing directory

if ($opts{b})
  {
    my @bt;
    while (<>)
      {
# Intel
#       237 lfitools           00000000004BB8D2  sdl_mod_mp_sdl_sr         100  sdl_mod.F90
        if (m/^.*\s+(\d+)\s+(\S+)$/o)
          {
            unshift (@bt, "$2:$1");
          }
# DrHook
#       237 (pid=71798): /tmp/gmkpack/gmktmp.48341/Pcplpack/dirwork.5/mpl_abort_mod.F90:36  :  lfitools() [0x4bc950]
        elsif (m/\(pid=\d+\):\s+(\S+):(\d+)\s+:/o)
          {
            use File::Basename;
            unshift (@bt, &basename ($1) . ":$2");
          }
# EcDrhook
#       2179 [EC_DRHOOK:belenosndl0:1:1:72722:72722] [20230912:073752:1.114] [LinuxTraceBack] [06]: MASTERODB() [0xfeb397e] : field_array_module_update_view_field_3rb_array_() at field_array_module.F90:401
        elsif (m/^(?:\d+\s+)?\[EC_DRHOOK:.*\[0x\w+\]\s*:\s*.*\s+at\s+(\S+):(\d+)\s*$/o)
          {

            unshift (@bt, "$1:$2");
          }

      }
    unshift (@ARGV, reverse (@bt));
  }

# the workspace : the directory holding .vimgit/config, looking upward; otherwise the top
# of the current git repository; otherwise the current directory, once its repositories
# have been listed in .vimgit/config

my @NOTE;

my $ROOT = 'vimgit::workspace'->findroot ('.') || 'vimgit::git'->getTopDirectory (dir => '.');

unless ($ROOT)
  {
    my $n = 'vimgit::workspace'->discover ('.');
    unless ($n)
      {
        print STDERR "vimgit: no git repository here\n";
        exit (1);
      }
    $ROOT = '.';
    push @NOTE, "wrote .vimgit/config with $n repositories; edit it to reorder or remove them";
  }

$ROOT = &Cwd::abs_path ($ROOT);

# paths given on the command line become relative to the workspace; same suffixes as vimgit::edit

for (@ARGV)
  {
    my ($f, $s) = (m/^(.*?)((?::\d+(?:[.:]\d+)?|\(\d+\)(?::.*)?)?)$/o);
    if (($f =~ m,/,o) && (-f $f))
      {
# resolve the directory only (.., symbolic links), so that a link to a file stays a link
        my $abs = 'File::Spec'->catfile (&Cwd::abs_path (&dirname ($f)), &basename ($f));
        $_ = 'File::Spec'->abs2rel ($abs, $ROOT) . $s;
      }
  }

chdir ($ROOT) or die ("Cannot change directory to $ROOT");

my $WS = 'vimgit::workspace'->new (root => $ROOT);

push @NOTE, @{ $WS->{warnings} };

# -i : create missing indexes; -I : create them again; for all repositories, or those named

if ($opts{i} || $opts{I})
  {
    print "vimgit: $_\n" for (@NOTE);

    my @repo = $WS->repos ();

    if (@ARGV)
      {
        @repo = ();
        for my $name (@ARGV)
          {
            my $repo = $WS->repo ('File::Spec'->canonpath ($name));
            unless ($repo)
              {
                print STDERR "vimgit: `$name' is not a repository of the workspace\n";
                exit (1);
              }
            push @repo, $repo;
          }
      }

# one process per repository, -j at a time; -i skips the repositories already indexed

    @repo = grep { ! $_->uptodate () } @repo unless ($opts{I});

    print "vimgit: indexes are up to date\n" unless (@repo);

    $| = 1;

    my (%running, @failed);

    my $wait = sub
    {
      my $pid = waitpid (-1, 0);
      my $mount = delete $running{$pid};
      push @failed, $mount if ($?);
    };

    for my $repo (@repo)
      {
        $wait->() while (keys (%running) >= ($opts{j} > 0 ? $opts{j} : 1));

        my $pid = fork ();
        defined ($pid) or die ("Cannot fork: $!");

        if ($pid == 0)
          {
            my $t = time ();
            print "vimgit: indexing $repo->{mount}\n";
            $repo->build (force => $opts{I}, fhlog => ($opts{v} ? \*STDOUT : undef));
            printf ("vimgit: %s done (%d s)\n", $repo->{mount}, time () - $t);
            exit (0);
          }

        $running{$pid} = $repo->{mount};
      }

    $wait->() while (%running);

    if (@failed)
      {
        print STDERR "vimgit: indexing failed for @failed\n";
        exit (1);
      }

    exit (0);
  }

if (my @noindex = $WS->noindex ())
  {
    push @NOTE, "no index for @noindex: run vimgit -i";
  }

my $dTOP = '.vimgit';
my $dTMP = "$dTOP/tmp=";
my $dHLP = "$dTOP/hlp=";

&mkpath ($_)
  for ($dTOP, $dTMP, $dHLP);

my ($fCOM, $fHLP) = ("$dTOP/start.vim", "$dHLP/vimgit.txt");

my $hCOM = 'FileHandle'->new (">$fCOM");

my $HOME = (getpwuid $>)[7];

$hCOM->print (<< "EOF");


set helpfile=$fHLP
helptags $dHLP

if filereadable ('$HOME/.vimgit.rc')
  source $HOME/.vimgit.rc
endif

if has('perl')

perl <<
use lib "$BIN/lib", "$BIN/perl5";
use strict; 
use warnings; 
use vimgit; 
our \$EDITOR = 'vimgit'->new (TOP => "$dTOP", ROOT => "$ROOT", WARN => $opts{w}); 
.

EOF

for my $note (@NOTE)
  {
    (my $n = $note) =~ s/(["\\])/\\$1/go;
    $hCOM->print ("echohl WarningMsg | echomsg \"vimgit: $n\" | echohl None\n");
  }

$hCOM->print (<< 'EOF');
command! -nargs=1 F      :perl $::EDITOR->FIND (word => "<args>")
command! -nargs=1 FR     :perl $::EDITOR->FIND (word => "<args>", current => 1)
command! -nargs=0 C      :perl $::EDITOR->COMMIT ()
command! -nargs=1 E      :perl $::EDITOR->EDIT ("<args>")
command! -nargs=* T      :perl $::EDITOR->TRANSFORM ("<args>")
command! -nargs=0 H      :perl $::EDITOR->LOGHIST ()
command! -nargs=0 R      :perl $::EDITOR->REFRESH ()
map <TAB>                :perl $::EDITOR->FIND (auto => 1, new_window => 0, defn => 0)<CR>
map œ                    :perl $::EDITOR->FIND (auto => 1, new_window => 0, defn => 1)<CR>
map `                    :perl $::EDITOR->FIND (auto => 1, new_window => 0, defn => 1)<CR>
map ²                    :perl $::EDITOR->FIND (auto => 1, new_window => 0, defn => 1)<CR>
map <S-TAB>              :perl $::EDITOR->FIND (auto => 1, new_window => 1, defn => 0)<CR>
map <C-²>                :perl $::EDITOR->FIND (auto => 1, new_window => 1, defn => 1)<CR>
map <BS>                 :perl $::EDITOR->BACK ()<CR>
autocmd BufWritePre   *  :perl $::EDITOR->COMMIT ();
autocmd BufWritePost  *  :perl $::EDITOR->UPDATE ();
EOF

if ($opts{v})
  {
    $hCOM->print (<< "EOF");
perl \$::EDITOR->setlog (1);
EOF
  }



if (@ARGV)
  {

    my $method = 'EDIT';
    $method = 'BT'   if ($opts{b});

    my @arg = map { (my $a = $_) =~ s/([\\'])/\\$1/go; $a } @ARGV;

    local $" = "', '";
    $hCOM->print (<< "EOF");
perl \$::EDITOR->$method ('@arg')

EOF

  }

$hCOM->print (<< "EOF");

else
  echohl WarningMsg | echo "Vim requires an embedded Perl in order to run vimgit" | echohl None
endif

EOF

$hCOM->close ();


my $hHELP = 'FileHandle'->new (">$fHLP")->print ($HELP);

my $VIM = $ENV{VIMPACKVIM} || 'vim';

exec ($VIM, ($opts{g} ? ('-g') : ()), -S => $fCOM);


