#!/usr/bin/perl -w


my $HELP = << 'EOF';
*vimgit.txt*	vim with a word index of git repositories

KEYS						*vimgit-keys*

<TAB>		search the word under the cursor; in a result buffer, open
		the file or the line under the cursor, or show the next
		page on the <<<< >>>> line
<S-TAB>		same, in a new window
` ² œ		go to the definition of the routine (CALL x, #include
		"x.intfb.h"), module (USE x) or type (TYPE (x), CLASS (x))
		under the cursor; on %x, list the lines using component x
<C-²>		same, in a new window
<BS>		go back

COMMANDS					*vimgit-commands*

:F word		search a word in all the repositories of the workspace
:FR word	search a word in the repository of the current buffer
:E file		open a file: name, path, file:line, file:line.column
:R		scan again the files changed since the index was built
		(after changes made outside vim)
:CT [name [depth]]
		call tree of a routine (word under the cursor without a
		name); see |vimgit-calltree|
:CTR [name [depth]]
		tree of the routines calling it
:TT [name [depth]]
		type tree of a derived type: the types of its
		components; see |vimgit-typetree|
:TTR [name [depth]]
		tree of the types using it
:AT [name] [depth] [follow]
		the call sequences passing a variable as dummy argument
		name of the routine around the cursor; see |vimgit-argtrace|
:T align_args	align the declarations of dummy arguments (needs fxtran)
:T align_use	clean up and align USE statements (needs fxtran)
:C		make the current file a single link (done before writes)
:H		write the history of all windows to the log (-v)
:CONFIG		show the settings in use, and where they come from

RESULTS						*vimgit-results*

Results show 200 files at a time; <TAB> on the <<<< >>>> line at the end
shows the next ones. When a name matches several files, vimgit asks which
one to open.

CALL TREES					*vimgit-calltree*

Each routine is in the middle of the routines it calls, on its right; with
:CTR, callers are on the left of the routine they call. A routine is
expanded once, then "(see line N)". [+n]: other definitions exist. "(not
found)": no definition in the indexed repositories. "(type-bound)": CALL x%y,
not followed. In a tree, <TAB> on a name searches it, ² opens its definition
(a list for [+n]); on "(see line N)", both go to line N. blacklist lines of
.vimgit/config leave routines out.

TYPE TREES					*vimgit-typetree*

Each type is in the middle of its components of derived type, shown as
declared (TYPE (TT), POINTER :: MM), the parent type of EXTENDS first; with
:TTR, the types using it are on its left (MODEL%YRCST, TCHILD (extends)).
Notes as in call trees. ² on a type opens its definition, on a component
its declaration; <TAB> searches the word under the cursor.

ARGUMENT TRACES					*vimgit-argtrace*

One block per call passing a variable as the dummy argument, depth-first,
numbered [1.2.1]: the CALL with 2 statements around it, carets under the
argument. The chain goes up while the variable is a dummy argument
(ASSOCIATE names replaced), and ends with its declaration, a module, a
literal or an expression. A component of a dummy argument stops it, unless
follow is given. atdepth (5) levels by default. <TAB> or ² on a line opens
the file there. Needs fxtran.

WORKSPACE					*vimgit-workspace*

vimgit works in the directory holding .vimgit/config (looking upward),
otherwise in the current git repository. Indexes are built by vimgit -i
(missing ones) or vimgit -I (all, again). .vimgitignore files in
repositories exclude files.

CONFIGURATION					*vimgit-config*

~/.vimgit/config, then .vimgit/config, both Perl; the second adds to the
first or overrides it. Settings: repo qw (...) (workspace only), exclude
<repo> => '<pattern>', index qw (<glob> ...), blacklist qw (<name> ...),
git, vim, jobs, results, gitgrep, context, keep, depth, key <action> =>
<keys> (actions: search, search_window, definition, definition_window,
back). In lists, '-name' removes an entry, '-' empties the list. vimgit -c
and :CONFIG show the settings in use and where they come from.

DIRECTORIES					*vimgit-dir*

dir <name> => <path> (.vimgit/config) adds a directory that is not a git
repository; its files show as <name>/<path>. Its index is in
<dir>/.vimgit/, built by vimgit -i; the directory is walked when vim
starts, symbolic links not followed. Its files open read-only, unless
readwrite qw (<name> ...) lists it.
See README.md in the vimgit directory.
EOF

use strict;

use FindBin qw ($RealBin);
use lib "$RealBin/lib", "$RealBin/perl5";

use local::lib;

use File::Basename;
use File::Spec;
use FileHandle;
use Getopt::Long qw (:config no_ignore_case);
use Data::Dumper;
use File::Path;
use Cwd qw ();
use vimgit::config;
use vimgit::mini;
use vimgit::workspace;

# directory of vimgit, symbolic links resolved
our $BIN = $RealBin;


sub bt
{
  for (my $i = 0; ; $i++)
    {
      last unless (my @call = caller ($i));
      return if ($call[3] eq '(eval)');
    }

  print @_;

  print "\n";
  for (my $i = 0; ; $i++)
    {
      last unless (my @call = caller ($i));
      print " $i ", $call[1], ':', $call[2], "\n";
    }
  die "\n";
}

$SIG{__WARN__} = \&bt;
$SIG{__DIE__} = \&bt;

my @opts = qw (d v i I g b w h x c);
my %opts = map { ($_, 0), } @opts;
$opts{j} = undef;
&GetOptions ((map { ($_, \$opts{$_}) } @opts), 'j=i' => \$opts{j});

# ~/.vimgit/config first : it gives the path of git, needed to find the workspace

my @NOTE;

my $HC = eval { 'vimgit::config'->load () };
unless ($HC)
  {
    print STDERR $@;
    exit (1);
  }

'vimgit::git'->setpath ($HC->value ('git'));

sub checkgit
{
  unless (-x 'vimgit::git'->path ())
    {
      printf STDERR ("vimgit: cannot run git as %s; set git to the path of git in ~/.vimgit/config\n", 'vimgit::git'->path ());
      exit (1);
    }
}

&checkgit ();

# settings of older versions

push @NOTE, "\$GITVIMGIT is ignored; set git in ~/.vimgit/config" if ($ENV{GITVIMGIT});
push @NOTE, "\$VIMPACKVIM is ignored; set vim in ~/.vimgit/config" if ($ENV{VIMPACKVIM});
push @NOTE, "~/.vimgit.rc is no longer read; key mappings are set in ~/.vimgit/config"
  if (-f (($ENV{HOME} || (getpwuid $>)[7]) . '/.vimgit.rc'));

# the backtrace may be read from files given on the command line : before changing directory

if ($opts{b})
  {
    my @bt;
    while (<>)
      {
# Intel
#       237 lfitools           00000000004BB8D2  sdl_mod_mp_sdl_sr         100  sdl_mod.F90
        if (m/^.*\s+(\d+)\s+(\S+)$/o)
          {
            unshift (@bt, "$2:$1");
          }
# DrHook
#       237 (pid=71798): /tmp/gmkpack/gmktmp.48341/Pcplpack/dirwork.5/mpl_abort_mod.F90:36  :  lfitools() [0x4bc950]
        elsif (m/\(pid=\d+\):\s+(\S+):(\d+)\s+:/o)
          {
            use File::Basename;
            unshift (@bt, &basename ($1) . ":$2");
          }
# EcDrhook
#       2179 [EC_DRHOOK:belenosndl0:1:1:72722:72722] [20230912:073752:1.114] [LinuxTraceBack] [06]: MASTERODB() [0xfeb397e] : field_array_module_update_view_field_3rb_array_() at field_array_module.F90:401
        elsif (m/^(?:\d+\s+)?\[EC_DRHOOK:.*\[0x\w+\]\s*:\s*.*\s+at\s+(\S+):(\d+)\s*$/o)
          {

            unshift (@bt, "$1:$2");
          }

      }
    unshift (@ARGV, reverse (@bt));
  }

# the workspace : the directory holding .vimgit/config, looking upward; otherwise the top
# of the current git repository; otherwise the current directory, once its repositories
# have been listed in .vimgit/config

my $ROOT = 'vimgit::workspace'->findroot ('.') || 'vimgit::git'->getTopDirectory (dir => '.');

# -c : the settings in use, and where they come from

if ($opts{c})
  {
    my $c = eval { 'vimgit::config'->load (root => $ROOT) };
    unless ($c)
      {
        print STDERR $@;
        exit (1);
      }
    print "# vimgit settings" . ($ROOT ? " for $ROOT" : '') . "\n";
    print $c->text ();
    print "# warning: $_\n" for (@{ $c->{warnings} });
    print "# note: $_ uses the old format; the lines above are the new one\n" for (@{ $c->{old} });
    exit (0);
  }

unless ($ROOT)
  {
    my $n = 'vimgit::workspace'->discover ('.');
    unless ($n)
      {
        print STDERR "vimgit: no git repository here\n";
        exit (1);
      }
    $ROOT = '.';
    push @NOTE, "wrote .vimgit/config with $n repositories; edit it to reorder or remove them";
  }

$ROOT = &Cwd::abs_path ($ROOT);

# paths given on the command line become relative to the workspace; same suffixes as vimgit::edit

for (@ARGV)
  {
    my ($f, $s) = (m/^(.*?)((?::\d+(?:[.:]\d+)?|\(\d+\)(?::.*)?)?)$/o);
    if (($f =~ m,/,o) && (-f $f))
      {
# resolve the directory only (.., symbolic links), so that a link to a file stays a link
        my $abs = 'File::Spec'->catfile (&Cwd::abs_path (&dirname ($f)), &basename ($f));
        $_ = 'File::Spec'->abs2rel ($abs, $ROOT) . $s;
      }
  }

chdir ($ROOT) or die ("Cannot change directory to $ROOT");

my $WS = eval { 'vimgit::workspace'->new (root => $ROOT) };
unless ($WS)
  {
    print STDERR $@;
    exit (1);
  }

&checkgit ();

my $CF = $WS->{config};

push @NOTE, @{ $WS->{warnings} };

$opts{j} = $CF->value ('jobs') unless (defined ($opts{j}));

# -i : create missing indexes; -I : create them again; for all repositories, or those named

if ($opts{i} || $opts{I})
  {
    print "vimgit: $_\n" for (@NOTE);

    my @repo = $WS->repos ();

    if (@ARGV)
      {
        @repo = ();
        for my $name (@ARGV)
          {
            my $repo = $WS->repo ('File::Spec'->canonpath ($name));
            unless ($repo)
              {
                print STDERR "vimgit: `$name' is not a repository of the workspace\n";
                exit (1);
              }
            push @repo, $repo;
          }
      }

# one process per repository, -j at a time; -i skips the repositories already indexed

    @repo = grep { ! $_->uptodate () } @repo unless ($opts{I});

# directories (dir) not writable : no index

    for my $r (grep { $_->isa ('vimgit::dir') && ! -w $_->{top} } @repo)
      {
        print "vimgit: $r->{mount}: $r->{top} is not writable; no index\n";
      }
    @repo = grep { ! ($_->isa ('vimgit::dir') && ! -w $_->{top}) } @repo;

    print "vimgit: indexes are up to date\n" unless (@repo);

    $| = 1;

    my (%running, @failed);

    my $wait = sub
    {
      my $pid = waitpid (-1, 0);
      my $mount = delete $running{$pid};
      push @failed, $mount if ($?);
    };

    for my $repo (@repo)
      {
        $wait->() while (keys (%running) >= ($opts{j} > 0 ? $opts{j} : 1));

        my $pid = fork ();
        defined ($pid) or die ("Cannot fork: $!");

        if ($pid == 0)
          {
            my $t = time ();
            print "vimgit: indexing $repo->{mount}\n";
            $repo->build (force => $opts{I}, fhlog => ($opts{v} ? \*STDOUT : undef));
            printf ("vimgit: %s done (%d s)\n", $repo->{mount}, time () - $t);
            exit (0);
          }

        $running{$pid} = $repo->{mount};
      }

    $wait->() while (%running);

    if (@failed)
      {
        print STDERR "vimgit: indexing failed for @failed\n";
        exit (1);
      }

    exit (0);
  }

if (my @noindex = $WS->noindex ())
  {
    my @other = grep { $WS->repo ($_)->othersettings () } @noindex;
    push @NOTE, "no index for @noindex: run vimgit -i"
              . (@other ? " (@other: indexes built with other settings, or by an older vimgit)" : '');
  }

my $dTOP = '.vimgit';
my $dTMP = "$dTOP/tmp=";
my $dHLP = "$dTOP/hlp=";

&mkpath ($_)
  for ($dTOP, $dTMP, $dHLP);

my ($fCOM, $fHLP) = ("$dTOP/start.vim", "$dHLP/vimgit.txt");

my $hCOM = 'FileHandle'->new (">$fCOM");


$hCOM->print (<< "EOF");


set helpfile=$fHLP
helptags $dHLP

if has('perl')

perl <<
use lib "$BIN/lib", "$BIN/perl5";
use strict; 
use warnings; 
use vimgit; 
our \$EDITOR = 'vimgit'->new (TOP => "$dTOP", ROOT => "$ROOT", WARN => $opts{w}); 
.

EOF

for my $note (@NOTE)
  {
    (my $n = $note) =~ s/(["\\])/\\$1/go;
    $hCOM->print ("echohl WarningMsg | echomsg \"vimgit: $n\" | echohl None\n");
  }

$hCOM->print (<< 'EOF');
command! -nargs=1 F      :perl $::EDITOR->FIND (word => "<args>")
command! -nargs=1 FR     :perl $::EDITOR->FIND (word => "<args>", current => 1)
command! -nargs=* CT     :perl $::EDITOR->CALLTREE ("<args>")
command! -nargs=* CTR    :perl $::EDITOR->CALLTREE ("<args>", callers => 1)
command! -nargs=* TT     :perl $::EDITOR->CALLTREE ("<args>", types => 1)
command! -nargs=* TTR    :perl $::EDITOR->CALLTREE ("<args>", types => 1, users => 1)
command! -nargs=* AT     :perl $::EDITOR->ARGTRACE ("<args>")
command! -nargs=0 C      :perl $::EDITOR->COMMIT ()
command! -nargs=1 E      :perl $::EDITOR->EDIT ("<args>")
command! -nargs=* T      :perl $::EDITOR->TRANSFORM ("<args>")
command! -nargs=0 H      :perl $::EDITOR->LOGHIST ()
command! -nargs=0 R      :perl $::EDITOR->REFRESH ()
command! -nargs=0 CONFIG :perl $::EDITOR->CONFIG ()
autocmd BufWritePre   *  :perl $::EDITOR->COMMIT ();
autocmd BufWritePost  *  :perl $::EDITOR->UPDATE ();
EOF

# key mappings : the key settings of the configuration

my %ACTION = (search            => 'FIND (auto => 1, new_window => 0, defn => 0)',
              search_window     => 'FIND (auto => 1, new_window => 1, defn => 0)',
              definition        => 'FIND (auto => 1, new_window => 0, defn => 1)',
              definition_window => 'FIND (auto => 1, new_window => 1, defn => 1)',
              back              => 'BACK ()');

for my $action (@vimgit::config::ACTIONS)
  {
    $hCOM->printf ("map %-20s :perl \$::EDITOR->%s<CR>\n", $_, $ACTION{$action}) for ($CF->keysof ($action));
  }

if ($opts{v})
  {
    $hCOM->print (<< "EOF");
perl \$::EDITOR->setlog (1);
EOF
  }



if (@ARGV)
  {

    my $method = 'EDIT';
    $method = 'BT'   if ($opts{b});

    my @arg = map { (my $a = $_) =~ s/([\\'])/\\$1/go; $a } @ARGV;

    local $" = "', '";
    $hCOM->print (<< "EOF");
perl \$::EDITOR->$method ('@arg')

EOF

  }

$hCOM->print (<< "EOF");

else
  echohl WarningMsg | echo "Vim requires an embedded Perl in order to run vimgit" | echohl None
endif

EOF

$hCOM->close ();


my $hHELP = 'FileHandle'->new (">$fHLP")->print ($HELP);

my $VIM = $CF->value ('vim');

exec ($VIM, ($opts{g} ? ('-g') : ()), -S => $fCOM);


